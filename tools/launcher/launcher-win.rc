/*
 * Resources for ChromiumStack.exe: the icon Explorer draws, and the version
 * block Task Manager and the file properties dialog read.
 *
 * The icon path is resolved through windres --include-dir, which tools/build-exe.sh
 * points at the project root.
 */
#include <winver.h>

/* The lowest-numbered icon resource is the one Explorer uses for the file. */
1 ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ChromiumStack - run an old Chromium engine"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "ChromiumStack"
            VALUE "OriginalFilename","ChromiumStack.exe"
            VALUE "ProductName",     "ChromiumStack"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
